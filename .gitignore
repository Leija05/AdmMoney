# ==============================================================================
# ADM MONEY — REPOSITORIO COMPLETO (.gitignore)
# Protege contraseñas, variables de entorno, dependencias y archivos compilados
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SEGURIDAD & SECRETOS CRÍTICOS (NUNCA SUBIR A GITHUB / GIT)
# ------------------------------------------------------------------------------
# Archivos de variables de entorno (con contraseñas de MongoDB, JWT secrets, etc.)
.env
.env.*
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

.agents

# Permitir explícitamente los ejemplos de plantilla seguros
!.env.example
!*.env.example

# Llaves privadas, certificados SSL y tokens
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
id_rsa
id_rsa.pub

# Llaves de firma móvil (Android Keystores) y credenciales de servicios
*.keystore
*.jks
google-services.json
GoogleService-Info.plist
firebase-adminsdk*.json

# ------------------------------------------------------------------------------
# 2. PYTHON / BACKEND FASTAPI
# ------------------------------------------------------------------------------
# Entornos virtuales de Python
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Bytecode compilado y caché
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# python venv libs (sin afectar src/lib del frontend)
/lib/
/lib64/
!**/src/lib/**
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Pruebas y cobertura
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml

# Bases de datos locales SQLite y respaldos
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# Archivos subidos por usuarios y comprobantes escaneados
uploads/
temp_uploads/
receipts/
admmoney-backend/uploads/
admmoney-backend/admmoney.db

# ------------------------------------------------------------------------------
# 3. NODE.JS / WEB (VITE & REACT) & MÓVIL (REACT NATIVE / EXPO)
# ------------------------------------------------------------------------------
# Carpetas pesadas de paquetes
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Compilados de producción
dist/
dist-ssr/
build/
out/
.next/
.turbo/
.cache/

# Archivos de compilación TypeScript
*.tsbuildinfo
tsconfig.tsbuildinfo

# ------------------------------------------------------------------------------
# 4. EXPO & ANDROID / IOS NATIVO (APP MÓVIL)
# ------------------------------------------------------------------------------
# Caché de Expo CLI y EAS
.expo/
.expo-shared/
web-build/

# Binarios e instaladores generados (nunca versionar instaladores de varios MBs)
*.apk
*.aab
*.ipa
*.app

# Carpetas nativas generadas en prebuild de Expo (si se ejecta)
# AdmMoneyMovil/frontend/android/
# AdmMoneyMovil/frontend/ios/
.gradle/
local.properties
.cxx/

# ------------------------------------------------------------------------------
# 5. SISTEMA OPERATIVO & EDITORES DE CÓDIGO (IDE)
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*

# Visual Studio Code & JetBrains
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/
.idea/
*.sublime-project
*.sublime-workspace

# Logs generales
logs/
*.log

# Archivos temporales de agentes o scratchpad
.gemini/
scratch/
*.tmp
*.temp
